# AI provider defaults
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

# Session-scoped Model Agent canary. Disabled in production unless explicitly enabled.
# Provider values: openai_compatible, anthropic, azure_openai, gemini.
VDT_MODEL_AGENT_ENABLED=false
VDT_MODEL_AGENT_PROVIDER=openai_compatible
VDT_MODEL_AGENT_MODEL=gpt-4.1-mini

# Temporary per-decision provider compatibility route. Keep false for target architecture.
VDT_AGENT_LEGACY_COMPATIBILITY_ENABLED=false

# Server-side research provider for research.search_web.
# Supported values: brave, tavily, noop. Leave unset for controlled Noop fallback.
VDT_RESEARCH_PROVIDER=noop
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
VDT_RESEARCH_TIMEOUT_MS=10000
VDT_RESEARCH_MAX_RESULTS=5

# Local runner
LOCAL_RUNNER_URL=http://localhost:8765
