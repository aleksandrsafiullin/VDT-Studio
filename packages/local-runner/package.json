{
  "name": "@vdt-studio/local-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@vdt-studio/model-bridge": "workspace:*",
    "@vdt-studio/vdt-agent": "workspace:*",
    "@vdt-studio/vdt-core": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server-runtime": "./src/server/runtime.ts",
    "./apple-foundation-models": "./src/apple-foundation-models/transport.ts",
    "./speech": "./src/speech/runtime.ts",
    "./speech-catalog": "./src/speech/catalog.ts",
    "./codex-subscription-capability": "./src/speech/codex-subscription-capability.ts",
    "./speech-audio": "./src/speech/audio.ts",
    "./timeout-limits": "./src/timeout-limits.ts"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. exec vitest run packages/local-runner/src"
  }
}
